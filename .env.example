# ============================================
# ESCOLHA UM PROVEDOR: anthropic OU openrouter
# ============================================

# Provedor de API (anthropic ou openrouter)
API_PROVIDER=anthropic

# ============================================
# CONFIGURAÇÃO ANTHROPIC
# ============================================
# Se usar API_PROVIDER=anthropic, configure apenas esta chave:
ANTHROPIC_API_KEY=your_anthropic_key_here

# ============================================
# CONFIGURAÇÃO OPENROUTER
# ============================================
# Se usar API_PROVIDER=openrouter, configure apenas esta chave:
OPENROUTER_API_KEY=your_openrouter_key_here

# ============================================
# MODELOS POR AGENTE
# ============================================
# Você pode usar modelos diferentes para cada agente!
# Para Anthropic, use: claude-sonnet-4-5-20250929, claude-opus-4-5-20251101, etc.
# Para OpenRouter, use: anthropic/claude-sonnet-4-5, openai/gpt-4, etc.

# Agente de Pesquisa (recomendado: modelo forte)
MODEL_RESEARCH=claude-sonnet-4-5-20250929

# Agente de Escrita (recomendado: modelo equilibrado)
MODEL_WRITER=claude-sonnet-4-5-20250929

# Agente de Revisão (recomendado: modelo forte)
MODEL_REVIEWER=claude-sonnet-4-5-20250929

# Agente de Schemas (recomendado: modelo mais barato, tarefa técnica)
MODEL_SCHEMA=claude-sonnet-4-5-20250929

# Modelo padrão (se não especificar por agente)
MODEL=claude-sonnet-4-5-20250929

# ============================================
# WEB RESEARCH (PESQUISA PROFUNDA NA WEB)
# ============================================
# IMPORTANTE: Esta é a funcionalidade PRINCIPAL do sistema!
# Quando habilitado, o agente de pesquisa consulta 100+ sites reais

# Habilitar pesquisa web real? (true ou false)
ENABLE_WEB_RESEARCH=true

# Provedor de busca (brave ou tavily)
WEB_SEARCH_PROVIDER=brave

# ============================================
# BRAVE SEARCH API (Recomendado - GRÁTIS)
# ============================================
# Obtenha em: https://brave.com/search/api/
# Grátis: 2.000 consultas/mês
# Perfeito para começar!
BRAVE_API_KEY=your_brave_api_key_here

# ============================================
# TAVILY AI (Alternativa - Pago)
# ============================================
# Obtenha em: https://tavily.com/
# Focado em research com IA
# $0.001 por busca
TAVILY_API_KEY=your_tavily_api_key_here

# ============================================
# OUTRAS CONFIGURAÇÕES
# ============================================
# Diretório para salvar os artigos gerados
OUTPUT_DIR=./output
