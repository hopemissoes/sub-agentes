# ============================================
# CONFIGURAÇÃO DO PROJETO
# ============================================

# Provedor de API
API_PROVIDER=openrouter

# ============================================
# OPENROUTER - Coloque sua chave aqui!
# ============================================
OPENROUTER_API_KEY=sk-or-v1-COLE_SUA_CHAVE_AQUI

# ============================================
# MODELOS POR AGENTE
# ============================================

# ────────────────────────────────────────────
# AGENTE DE PESQUISA (escolha UM modelo)
# ────────────────────────────────────────────

# ✅ OPÇÃO 1: Perplexity Sonar Huge (RECOMENDADO - Pesquisa MUITO profunda)
MODEL_RESEARCH=perplexity/llama-3.1-sonar-huge-128k-online

# OPÇÃO 2: Perplexity Sonar Large (Bom custo-benefício)
# MODEL_RESEARCH=perplexity/llama-3.1-sonar-large-128k-online

# OPÇÃO 3: Perplexity Sonar Base (Mais barato)
# MODEL_RESEARCH=perplexity/llama-3.1-sonar-128k-online

# OPÇÃO 4: DeepSeek R1 (Muito barato, com raciocínio)
# MODEL_RESEARCH=deepseek/deepseek-r1

# OPÇÃO 5: Gemini 2.0 Flash (GRÁTIS - para testes)
# MODEL_RESEARCH=google/gemini-2.0-flash-exp:free

# OPÇÃO 6: Gemini 1.5 Pro (Contexto gigante + Google Search)
# MODEL_RESEARCH=google/gemini-pro-1.5

# OPÇÃO 7: Claude Opus (SEM pesquisa web - só conhecimento base)
# MODEL_RESEARCH=anthropic/claude-opus-4.5

# OPÇÃO 8: Claude Sonnet (SEM pesquisa web - só conhecimento base)
# MODEL_RESEARCH=anthropic/claude-sonnet-4-5

# ────────────────────────────────────────────
# AGENTE DE ESCRITA (escolha UM modelo)
# ────────────────────────────────────────────

# ✅ RECOMENDADO: Claude Sonnet (excelente para escrever)
MODEL_WRITER=anthropic/claude-sonnet-4-5

# Alternativas:
# MODEL_WRITER=anthropic/claude-opus-4.5        # Mais criativo
# MODEL_WRITER=google/gemini-pro-1.5            # Boa qualidade
# MODEL_WRITER=deepseek/deepseek-r1             # Muito barato

# ────────────────────────────────────────────
# AGENTE DE REVISÃO (escolha UM modelo)
# ────────────────────────────────────────────

# ✅ RECOMENDADO: Claude Sonnet (excelente análise crítica)
MODEL_REVIEWER=anthropic/claude-sonnet-4-5

# Alternativas:
# MODEL_REVIEWER=anthropic/claude-opus-4.5      # Mais rigoroso
# MODEL_REVIEWER=google/gemini-pro-1.5          # Boa qualidade

# ────────────────────────────────────────────
# AGENTE DE SCHEMA (escolha UM modelo)
# ────────────────────────────────────────────

# ✅ RECOMENDADO: Claude Haiku (rápido e barato)
MODEL_SCHEMA=anthropic/claude-haiku-4

# Alternativas:
# MODEL_SCHEMA=anthropic/claude-sonnet-4-5      # Mais detalhado
# MODEL_SCHEMA=google/gemini-2.0-flash-exp:free # GRÁTIS

# ============================================
# WEB RESEARCH (DEPRECIADO)
# ============================================
# Se usar modelo com pesquisa nativa (Perplexity, Gemini, DeepSeek),
# deixe ENABLE_WEB_RESEARCH=false
#
# Se usar Claude (sem pesquisa web), pode ativar para usar Brave API:
# ENABLE_WEB_RESEARCH=true

ENABLE_WEB_RESEARCH=false
WEB_SEARCH_PROVIDER=brave
BRAVE_API_KEY=OPCIONAL

# ============================================
# OUTRAS CONFIGURAÇÕES
# ============================================
OUTPUT_DIR=./output

# ============================================
# 📚 DOCUMENTAÇÃO
# ============================================
# Veja MODELOS-PESQUISA.md para detalhes sobre cada modelo:
# - Custos
# - Capacidades
# - Quando usar cada um
# - Comparações
